{
  "name": "branching-video",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight branching video player on top of YouTube embeds.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm build && playwright test",
    "lint": "eslint . --max-warnings 0",
    "validate": "node tools/validate-config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
