{
  "name": "branching-video",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight branching video player on top of YouTube embeds.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm build && playwright test",
    "lint": "eslint . --max-warnings 0",
    "validate": "node tools/validate-config.ts",
    "casts": "node tools/any-registry-check.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.11",
    "eslint": "10.15.0",
    "fast-check": "4.11.0",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
